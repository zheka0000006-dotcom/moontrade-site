ine x1=\"425.0\" x2=\"425.0\" y1=\"144.7\" y2=\"168.4\" stroke=\"#ff6b8a\" stroke-width=\"1.5\"/>\n<rect x=\"420.4\" y=\"148.0\" width=\"9.2\" height=\"17.0\" rx=\"1.5\" fill=\"#ff6b8a\"/>\n<line x1=\"440.9\" x2=\"440.9\" y1=\"159.8\" y2=\"184.6\" stroke=\"#ff6b8a\" stroke-width=\"1.5\"/>\n<rect x=\"436.3\" y=\"165.0\" width=\"9.2\" height=\"14.4\" rx=\"1.5\" fill=\"#ff6b8a\"/>\n<line x1=\"456.8\" x2=\"456.8\" y1=\"152.4\" y2=\"182.5\" stroke=\"#3fe0a0\" stroke-width=\"1.5\"/>\n<rect x=\"452.2\" y=\"156.3\" width=\"9.2\" height=\"23.1\" rx=\"1.5\" fill=\"#3fe0a0\"/>\n<line x1=\"472.6\" x2=\"472.6\" y1=\"138.0\" y2=\"157.4\" stroke=\"#3fe0a0\" stroke-width=\"1.5\"/>\n<rect x=\"468.0\" y=\"139.5\" width=\"9.2\" height=\"16.8\" rx=\"1.5\" fill=\"#3fe0a0\"/>\n<line x1=\"488.5\" x2=\"488.5\" y1=\"116.3\" y2=\"141.4\" stroke=\"#3fe0a0\" stroke-width=\"1.5\"/>\n<rect x=\"483.9\" y=\"120.7\" width=\"9.2\" height=\"18.8\" rx=\"1.5\" fill=\"#3fe0a0\"/>\n<line x1=\"504.4\" x2=\"504.4\" y1=\"98.4\" y2=\"122.9\" stroke=\"#3fe0a0\" stroke-width=\"1.5\"/>\n<rect x=\"499.8\" y=\"102.2\" width=\"9.2\" height=\"18.5\" rx=\"1.5\" fill=\"#3fe0a0\"/>\n<line x1=\"520.3\" x2=\"520.3\" y1=\"86.8\" y2=\"106.1\" stroke=\"#3fe0a0\" stroke-width=\"1.5\"/>\n<rect x=\"515.7\" y=\"88.6\" width=\"9.2\" height=\"13.6\" rx=\"1.5\" fill=\"#3fe0a0\"/>\n<line x1=\"536.2\" x2=\"536.2\" y1=\"87.0\" y2=\"97.0\" stroke=\"#ff6b8a\" stroke-width=\"1.5\"/>\n<rect x=\"531.6\" y=\"88.6\" width=\"9.2\" height=\"7.3\" rx=\"1.5\" fill=\"#ff6b8a\"/>\n<line x1=\"552.1\" x2=\"552.1\" y1=\"90.6\" y2=\"126.7\" stroke=\"#ff6b8a\" stroke-width=\"1.5\"/>\n<rect x=\"547.5\" y=\"95.9\" width=\"9.2\" height=\"28.3\" rx=\"1.5\" fill=\"#ff6b8a\"/>\n<text x=\"574.0\" y=\"77.3\" fill=\"#cdbdff\" font-family=\"Manrope,system-ui,sans-serif\" font-size=\"20\" font-weight=\"700\" text-anchor=\"start\">верхня</text>\n<text x=\"574.0\" y=\"128.5\" fill=\"#ffc85c\" font-family=\"Manrope,system-ui,sans-serif\" font-size=\"20\" font-weig